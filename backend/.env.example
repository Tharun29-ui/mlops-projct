APP_NAME=Autonomous Business OS API
APP_ENV=local
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AWS_REGION=ap-southeast-2
DATABASE_URL=sqlite:///../data/local.db
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_BYTES=15728640
# Set only in the deployed API Lambda. Never commit real values.
DATABASE_SECRET_ARN=
INVOICE_BUCKET_NAME=
EXTRACTION_JOBS_TABLE_NAME=
AWS_EXTRACTION_ENABLED=false
BUSINESS_NAME=
BUSINESS_GSTIN=
BUSINESS_ADDRESS=
